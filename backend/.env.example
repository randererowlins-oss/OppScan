# ─── OppScan API environment ─────────────────────────────
# Copy to `.env`:  cp .env.example .env

# Port the API listens on
PORT=4000

# Comma-separated list of allowed browser origins (CORS).
# For local dev the Vite frontend runs on :5173.
CORS_ORIGIN=http://localhost:5173

# Secret used to sign JWT access tokens. Use a long random string in production:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=dev-only-secret-change-me

# Token lifetime (jsonwebtoken `expiresIn` format)
JWT_EXPIRES_IN=7d

# Path (relative to backend/) of the JSON database file
DB_FILE=./data/db.json
